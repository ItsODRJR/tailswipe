PORT=4000
DATABASE_URL=postgres://tailswipe:CHANGE_ME@localhost:5432/tailswipe
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
PUBLIC_BASE_URL=http://162.35.190.13:4000

# APNs (push notifications) — leave blank to disable push sends.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_PATH=./apns_auth_key.p8
APNS_BUNDLE_ID=org.tailswipe.app
APNS_ENV=sandbox

# SMTP (email verification) — leave SMTP_USER/SMTP_PASS blank to log codes to the
# console instead of emailing them. For Gmail: SMTP_USER is the full address, SMTP_PASS
# is a 16-character App Password (Google Account > Security > App passwords, requires 2FA).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
